{
  "dxt_version": "0.2",
  "name": "wuro-mcp",
  "version": "1.1.0",
  "description": "The official MCP Server for the Wuro API",
  "author": {
    "name": "Wuro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agence-awelty/wuro-typescript.git"
  },
  "homepage": "https://github.com/agence-awelty/wuro-typescript/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "WURO_APP_ID": "${user_config.WURO_APP_ID}",
        "WURO_APP_SECRET": "${user_config.WURO_APP_SECRET}"
      }
    }
  },
  "user_config": {
    "WURO_APP_ID": {
      "title": "app_id",
      "description": "",
      "required": false,
      "type": "string"
    },
    "WURO_APP_SECRET": {
      "title": "app_secret",
      "description": "",
      "required": false,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
