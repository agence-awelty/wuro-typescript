{
  "dxt_version": "0.2",
  "name": "wuro-mcp",
  "version": "1.1.0",
  "description": "The official MCP Server for the Wuro API",
  "author": {
    "name": "Wuro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agence-awelty/wuro-typescript.git"
  },
  "homepage": "https://github.com/agence-awelty/wuro-typescript/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "WURO_API_KEY": "${user_config.WURO_API_KEY}",
        "WURO_PRIVATE_KEY": "${user_config.WURO_PRIVATE_KEY}"
      }
    }
  },
  "user_config": {
    "WURO_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    },
    "WURO_PRIVATE_KEY": {
      "title": "private_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
